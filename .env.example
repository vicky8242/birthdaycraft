# Copy to .env.local and fill in your values.
# The site runs with NONE of these set (demo mode: no database, no real payments),
# which is handy for trying it out locally. Set them all before going live.

# ── Site ────────────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for share links, Open Graph, sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Price per surprise in rupees (shown in the UI AND charged by the server)
NEXT_PUBLIC_WISH_PRICE_INR=99
# Optional: shows a "Support" mailto link in the footer
NEXT_PUBLIC_SUPPORT_EMAIL=
# (Songs need no setting – just add the mp3 files to public/music/, see README)

# ── Supabase (database + photo storage) ─────────────────────────────────────
# Run supabase/schema.sql in the Supabase SQL editor first.
# The service-role key is SERVER ONLY — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Razorpay (payments) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
